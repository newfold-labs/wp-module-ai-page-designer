{
    "name": "newfold-labs/wp-module-ai-page-designer",
    "description": "AI-powered page and post designer for WordPress with live preview and publishing capabilities",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Newfold Digital",
            "homepage": "https://newfold.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "NewfoldLabs\\WP\\Module\\AIPageDesigner\\": "includes"
        },
        "files": [
            "bootstrap.php"
        ]
    },
    "require": {
        "php": ">=7.3",
        "newfold-labs/wp-module-loader": "^1.0",
        "newfold-labs/wp-module-data": "^2.0",
        "newfold-labs/wp-module-ai": "^1.3"
    },
    "scripts": {
        "lint": "vendor/bin/phpcs --standard=phpcs.xml .",
        "fix": "vendor/bin/phpcbf --standard=phpcs.xml .",
        "i18n-pot": "vendor/bin/wp i18n make-pot . ./languages/wp-module-ai-page-designer.pot --domain=wp-module-ai-page-designer --headers='{\"Report-Msgid-Bugs-To\":\"https://github.com/newfold-labs/wp-module-ai-page-designer/issues\",\"POT-Creation-Date\":\"2025-03-10T00:00:00+00:00\"}' --exclude=node_modules,build,tests,vendor,wordpress",
        "i18n-po": "vendor/bin/wp i18n update-po ./languages/wp-module-ai-page-designer.pot ./languages",
        "i18n-php": "vendor/bin/wp i18n make-php ./languages --pretty-print",
        "i18n-json": "rm -f languages/*.json && vendor/bin/wp i18n make-json ./languages --pretty-print",
        "i18n": [
            "@i18n-pot",
            "@i18n-po",
            "@i18n-php",
            "@i18n-json"
        ],
        "i18n-ci-pre": [
            "@i18n-pot",
            "@i18n-po"
        ],
        "i18n-ci-post": [
            "@i18n-json",
            "@i18n-php"
        ],
        "i18n-mo": "vendor/bin/wp i18n make-mo ./languages"
    },
    "require-dev": {
        "newfold-labs/wp-php-standards": "^1.2.5",
        "wp-cli/i18n-command": "^2.7.0",
        "roave/security-advisories": "dev-latest"
    },
    "repositories": {
        "newfold": {
            "type": "composer",
            "url": "https://newfold-labs.github.io/satis/",
            "only": [
                "newfold-labs/*"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
